{
  "manifest_version": 3,
  "name": "eOfficeGate",
  "version": "1.4.0",
  "description": "Unified assistant for WBSEDCL eOffice & CRM: Auto-fills login CAPTCHA and prevents session timeouts with background keep-alive heartbeats and automatic GitHub update checking.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://eoffice.wbsedcl.in/*",
    "https://wbcrmap.wbsedcl.in:4443/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eoffice.wbsedcl.in/*",
        "https://wbcrmap.wbsedcl.in:4443/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "eOfficeGate",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "options_page": "options.html"
}
